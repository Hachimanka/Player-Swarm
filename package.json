{
    "name": "ts-express-scaffolding",
    "version": "1.0.0",
    "description": "Enterprise Node.js REST API Server with TypeScript",
    "main": "dist/server.js",
    "scripts": {
        "dev": "cross-env NODE_ENV=development node --watch --require ts-node/register --require tsconfig-paths/register src/server.ts",
        "build": "rimraf dist && tsc",
        "start": "node -r module-alias/register dist/server.js",
        "start:prod": "NODE_ENV=production node -r module-alias/register dist/server.js",
        "test": "jest --config config/jest.config.js",
        "test:watch": "jest --config config/jest.config.js --watch",
        "test:coverage": "jest --config config/jest.config.js --coverage",
        "lint": "eslint --config config/eslint.config.js src/**/*.ts",
        "lint:fix": "eslint --config config/eslint.config.js src/**/*.ts --fix",
        "format": "prettier --write src/**/*.ts",
        "validate": "npm run lint && npm run test",
        "prepare": "husky",
        "pretty": "prettier --write \"./**/*.{html,js,jsx,mjs,cjs,ts,tsx,json,scss,css}\"",
        "pretty:quick": "pretty-quick",
        "pretty:staged": "pretty-quick --staged",
        "pretty:check": "pretty-quick --check"
    },
    "keywords": [
        "nodejs",
        "typescript",
        "express",
        "rest-api",
        "enterprise"
    ],
    "author": "N-Compass TV",
    "license": "ISC",
    "dependencies": {
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.2",
        "helmet": "^8.3.0",
        "joi": "^18.2.3",
        "module-alias": "^2.3.4",
        "morgan": "^1.11.0",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/morgan": "^1.9.10",
        "@types/node": "^24.13.3",
        "@types/supertest": "^7.2.1",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "pretty-quick": "^4.2.2",
        "rimraf": "^6.1.3",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">=24.0.0",
        "npm": ">=10.0.0"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "_moduleAliases": {
        "@config": "dist/config",
        "@controllers": "dist/controllers",
        "@middlewares": "dist/middlewares",
        "@models": "dist/models",
        "@routes": "dist/routes",
        "@services": "dist/services",
        "@utils": "dist/utils",
        "@types": "dist/types",
        "@interfaces": "dist/interfaces",
        "@schemas": "dist/schemas"
    }
}
