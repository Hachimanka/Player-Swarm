{
    "name": "ts-express-scaffolding",
    "version": "1.0.0",
    "description": "Enterprise Node.js REST API Server with TypeScript",
    "main": "dist/server.js",
    "scripts": {
        "dev": "nodemon --config config/nodemon.json",
        "build": "rimraf dist && tsc",
        "start": "node -r module-alias/register dist/server.js",
        "start:prod": "NODE_ENV=production node -r module-alias/register dist/server.js",
        "test": "jest --config config/jest.config.js",
        "test:watch": "jest --config config/jest.config.js --watch",
        "test:coverage": "jest --config config/jest.config.js --coverage",
        "lint": "eslint --config config/eslint.config.js src/**/*.ts",
        "lint:fix": "eslint --config config/eslint.config.js src/**/*.ts --fix",
        "format": "prettier --write src/**/*.ts",
        "validate": "npm run lint && npm run test",
        "prepare": "husky install"
    },
    "keywords": [
        "nodejs",
        "typescript",
        "express",
        "rest-api",
        "enterprise"
    ],
    "author": "N-Compass TV",
    "license": "ISC",
    "dependencies": {
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^7.4.0",
        "helmet": "^7.1.0",
        "joi": "^17.13.3",
        "morgan": "^1.10.0",
        "winston": "^3.13.0",
        "winston-daily-rotate-file": "^5.0.0",
        "module-alias": "^2.2.3"
    },
    "devDependencies": {
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.12",
        "@types/morgan": "^1.9.9",
        "@types/node": "^22.5.0",
        "@types/supertest": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^8.2.0",
        "@typescript-eslint/parser": "^8.2.0",
        "eslint": "^9.9.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "husky": "^9.1.4",
        "jest": "^29.7.0",
        "lint-staged": "^15.2.8",
        "nodemon": "^3.1.4",
        "prettier": "^3.3.3",
        "rimraf": "^6.0.1",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.5.4"
    },
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "_moduleAliases": {
        "@config": "dist/config",
        "@controllers": "dist/controllers",
        "@middlewares": "dist/middlewares",
        "@models": "dist/models",
        "@routes": "dist/routes",
        "@services": "dist/services",
        "@utils": "dist/utils",
        "@types": "dist/types"
    }
}
