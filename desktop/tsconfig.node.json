{
    "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
    "include": ["electron.vite.config.ts", "src/main/**/*", "src/preload/**/*", "src/shared/**/*"],
    "compilerOptions": {
        "composite": true,
        "types": ["electron-vite/node"],
        "strict": true,
        "noImplicitAny": true,
        "noUncheckedIndexedAccess": true,
        "paths": {
            "@shared/*": ["./src/shared/*"]
        }
    }
}
