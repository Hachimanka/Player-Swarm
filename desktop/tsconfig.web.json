{
    "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
    "include": ["src/renderer/**/*", "src/shared/**/*"],
    "compilerOptions": {
        "composite": true,
        "strict": true,
        "noImplicitAny": true,
        "noUncheckedIndexedAccess": true,
        "experimentalDecorators": true,
        "useDefineForClassFields": false,
        "paths": {
            "@shared/*": ["./src/shared/*"]
        }
    }
}
