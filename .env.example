# Application Configuration
NODE_ENV=development
PORT=3000

# API Configuration
API_VERSION=v1

# Database Configuration (if needed)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ts_express_scaffolding
# DB_USER=your_username
# DB_PASSWORD=your_password

# External Service Configuration
# PXCHANGE_API_URL=https://api.pxchange.com
# VISTAR_API_URL=https://api.vistar.com

# Security
# JWT_SECRET=your_jwt_secret_here
# API_KEY=your_api_key_here

# Logging
LOG_LEVEL=info
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m
